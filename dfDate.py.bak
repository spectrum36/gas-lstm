import pandas as pd

def getDateDf(date, endDate):
    dates = [str(date[0]) + f"-{date[1]:02d}-{date[2]:02d}"]

    while date[0] > endDate[0] or date[1] > endDate[1] or date[2] > endDate[2]:
        date[2] = date[2] - 1
        if date[2] == 0:
            date[1] = date[1] - 1
            if date[1] in {1, 3, 5, 7, 9, 10, 12}:
                date[2] = 31
            elif date[1] in {4, 6, 8, 11}:
                date[2] = 30
            elif date[1] == 2:
                if date[0] % 4 == 0:
                    date[2] = 29
                else:
                    date[2] = 28
            else:
                date[0] = date[0] - 1
                date[1] = 12
                date[2] = 31
        dates.append(str(date[0]) + f"-{date[1]:02d}-{date[2]:02d}")
    d = {"date": dates}
    df = pd.DataFrame(data=d)

    df = df.set_index('date')
    return(df)

